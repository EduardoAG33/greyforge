        "id": "org.robotblocks.demo-board-io:digital-write-value",
        "category": "org.robotblocks.demo-board-io:pins",
        "label": {
          "es": "escribir pin digital %PIN valor %VALUE",
          "en": "write digital pin %PIN value %VALUE"
        },
        "kind": "command",
        "fields": [
          {
            "name": "PIN",
            "type": "string",
            "default": "",
            "reference": {
              "kind": "resource",
              "capabilities": ["digitalOutput"]
            }
          }
        ],
        "inputs": [
          {
            "name": "VALUE",
            "type": "number",
            "default": 1,
            "min": 0,
            "max": 1,
            "integer": true
          }
        ],
        "operation": "org.robotblocks.demo-board-io:digital-write-value",
        "tooltip": {
          "es": "MicroPython ESP32 experimental. Revisa las capacidades y las notas del pin antes de cargar. Arduino experimental: API del core, sin librerías externas.",
          "en": "Experimental ESP32 MicroPython. Check pin capabilities and notes before uploading. Experimental Arduino: core API, no external libraries."
        },
        "requiredCapabilities": ["digitalOutput"],
        "generators": {
          "micropython": {
            "canFail": false,
            "imports": ["from machine import Pin, PWM"],
            "setup": ["pin_{PIN} = Pin({PIN}, Pin.OUT)"],
            "statement": "pin_{PIN}.value({VALUE})"
          },
          "arduino": {
            "canFail": false,
            "setup": ["pinMode({PIN}, OUTPUT);"],
            "statement": "digitalWrite({PIN}, {VALUE});"
          }
        }
      }
