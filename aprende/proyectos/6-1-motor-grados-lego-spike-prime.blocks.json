        "id": "org.robotblocks.lego-spike:motor-angle",
        "category": "org.robotblocks.lego-spike:motors",
        "label": {
          "es": "motor %PORT girar %ANGLE grados a %SPEED grados/s",
          "en": "motor %PORT run %ANGLE degrees at %SPEED degrees/s"
        },
        "kind": "command",
        "fields": [
          {
            "name": "PORT",
            "type": "string",
            "default": "a",
            "reference": {
              "kind": "resource",
              "capabilities": ["poweredUpPort"]
            }
          }
        ],
        "inputs": [
          {
            "name": "ANGLE",
            "type": "number",
            "default": 90,
            "min": -2147483648,
            "max": 2147483647
          },
          {
            "name": "SPEED",
            "type": "number",
            "default": 500,
            "min": 1,
            "max": 2147483647
          }
        ],
        "operation": "org.robotblocks.lego-spike:motor-angle",
        "tooltip": {
          "es": "Pybricks 3.6.1+ / 4.0 experimental. Unidades indicadas en el bloque. Comprueba conexiones y calibración antes de ejecutar.",
          "en": "Experimental Pybricks 3.6.1+ / 4.0. Units shown in the block. Check connections and calibration before running."
        },
        "requiredCapabilities": ["poweredUpPort"],
        "generators": {
          "pybricks": {
            "cooperative": true,
            "statement": "await rb_motor({PORT}, {BLOCK_ID}).run_angle({SPEED}, {ANGLE})"
          }
        }
