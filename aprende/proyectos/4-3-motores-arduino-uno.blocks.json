      {
        "id": "org.robotblocks.motores:configure",
        "category": "org.robotblocks.motores:motores",
        "label": {
          "es": "configurar motor %MOTOR PWM %PWM IN1 %IN1 IN2 %IN2",
          "en": "configure motor %MOTOR PWM %PWM IN1 %IN1 IN2 %IN2"
        },
        "kind": "command",
        "fields": [
          {
            "name": "MOTOR",
            "type": "string",
            "default": "A",
            "options": [
              {
                "label": {
                  "es": "A",
                  "en": "A"
                },
                "value": "A"
              },
              {
                "label": {
                  "es": "B",
                  "en": "B"
                },
                "value": "B"
              },
              {
                "label": {
                  "es": "C",
                  "en": "C"
                },
                "value": "C"
              },
              {
                "label": {
                  "es": "D",
                  "en": "D"
                },
                "value": "D"
              }
            ]
          },
          {
            "name": "PWM",
            "type": "string",
            "default": "",
            "reference": {
              "kind": "resource",
              "capabilities": ["pwm"]
            }
          },
          {
            "name": "IN1",
            "type": "string",
            "default": "",
            "reference": {
              "kind": "resource",
              "capabilities": ["digitalOutput"]
            }
          },
          {
            "name": "IN2",
            "type": "string",
            "default": "",
            "reference": {
              "kind": "resource",
              "capabilities": ["digitalOutput"]
            }
          }
        ],
        "inputs": [],
        "operation": "org.robotblocks.motores:configure",
        "tooltip": {
          "es": "Ponlo en «al iniciar», una vez por motor. PWM va a ENA/PWMA; IN1 e IN2 a los pines de dirección. TB6612FNG o L298N. Si el motor gira al revés, intercambia IN1 e IN2 en «configurar motor».",
          "en": "Place in “when started”, once per motor. PWM connects to ENA/PWMA; IN1 and IN2 to the direction pins. TB6612FNG or L298N. If the motor spins backward, swap IN1 and IN2 in “configure motor”."
        },
        "requiredCapabilities": ["pwm", "digitalOutput"],
        "generators": {
          "micropython": {
            "canFail": false,
            "imports": ["from machine import Pin, PWM"],
            "globals": [
              "motores_puente = {}\n",
              "def motores_configurar(motor, pwm, in1, in2):\n    motores_puente[motor] = (PWM(Pin(pwm), freq=1000, duty_u16=0), Pin(in1, Pin.OUT, value=0), Pin(in2, Pin.OUT, value=0))\n"
            ],
            "statement": "motores_configurar({MOTOR}, {PWM}, {IN1}, {IN2})"
          },
          "arduino": {
            "hardware": {
              "features": ["pwm"]
            },
            "globals": [
              "struct RbMotor { int pwm = -1, ina = -1, inb = -1; };\nstatic RbMotor motores_puente[4];\ninline int motores_indice(const String& motor) { return motor.length() == 1 ? motor[0] - 'A' : -1; }\ninline void motores_configurar(const String& motor, int pwm, int ina, int inb) {\n    int i = motores_indice(motor); if (i < 0 || i > 3) return;\n    motores_puente[i].pwm = pwm; motores_puente[i].ina = ina; motores_puente[i].inb = inb;\n    pinMode(pwm, OUTPUT); pinMode(ina, OUTPUT); pinMode(inb, OUTPUT);\n    digitalWrite(ina, LOW); digitalWrite(inb, LOW); analogWrite(pwm, 0);\n}\ninline void motores_parar(RbMotor& m, bool frenar) {\n    digitalWrite(m.ina, frenar ? HIGH : LOW); digitalWrite(m.inb, frenar ? HIGH : LOW);\n    analogWrite(m.pwm, frenar ? {PWM_MAX} : 0);\n}\ninline void motores_velocidad(const String& motor, float velocidad, const char* bloque) {\n    int i = motores_indice(motor);\n    if (i < 0 || i > 3 || motores_puente[i].pwm < 0) { rb_fail(bloque, \"Motor sin configurar: usa configurar motor al iniciar\"); return; }\n    velocidad = fmaxf(-100, fminf(100, rb_finite(velocidad, bloque)));\n    RbMotor& m = motores_puente[i];\n    if (velocidad == 0) { motores_parar(m, false); return; }\n    digitalWrite(m.ina, velocidad > 0 ? HIGH : LOW); digitalWrite(m.inb, velocidad > 0 ? LOW : HIGH);\n    analogWrite(m.pwm, uint32_t(fabsf(velocidad) * {PWM_MAX} / 100.0f));\n}\ninline void motores_detener(const String& motor, const String& modo) {\n    for (int i = 0; i < 4; i++) if (motores_puente[i].pwm >= 0 && (motor == \"todos\" || motores_indice(motor) == i)) motores_parar(motores_puente[i], modo == \"frenar\");\n}"
            ],
            "statement": "motores_configurar({MOTOR}, {PWM}, {IN1}, {IN2});"
          }
        }
      },
      {
        "id": "org.robotblocks.motores:pair",
        "category": "org.robotblocks.motores:motores",
        "label": {
          "es": "motores %LEFT %LEFT_SPEED %RIGHT %RIGHT_SPEED",
          "en": "motors %LEFT %LEFT_SPEED %RIGHT %RIGHT_SPEED"
        },
        "kind": "command",
        "fields": [
          {
