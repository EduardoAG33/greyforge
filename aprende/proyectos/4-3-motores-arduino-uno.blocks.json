                },
                "value": "D"
              }
            ]
          }
        ],
        "inputs": [
          {
            "name": "LEFT_SPEED",
            "type": "number",
            "default": 50,
            "slider": {
              "min": -100,
              "max": 100
            }
          },
          {
            "name": "RIGHT_SPEED",
            "type": "number",
            "default": 50,
            "slider": {
              "min": -100,
              "max": 100
            }
          }
        ],
        "operation": "org.robotblocks.motores:pair",
        "tooltip": {
          "es": "Mueve dos motores a la vez, por ejemplo izquierdo y derecho. TB6612FNG o L298N. Si el motor gira al revés, intercambia IN1 e IN2 en «configurar motor».",
          "en": "Moves two motors at once, for example left and right. TB6612FNG or L298N. If the motor spins backward, swap IN1 and IN2 in “configure motor”."
        },
        "requiredCapabilities": ["pwm", "digitalOutput"],
        "generators": {
          "micropython": {
            "imports": ["from machine import Pin, PWM"],
            "globals": [
              "motores_puente = {}\n",
              "def motores_parar(salidas, modo):\n    pwm, in1, in2 = salidas\n    # Frenar: IN1 e IN2 en alto. Libre: PWM en 0 e IN1/IN2 en bajo (TB6612FNG y L298N).\n    frenar = modo == \"frenar\"\n    in1.value(1 if frenar else 0)\n    in2.value(1 if frenar else 0)\n    pwm.duty_u16(65535 if frenar else 0)\n",
              "def motores_velocidad(motor, velocidad, bloque):\n    salidas = motores_puente.get(motor)\n    if salidas is None:\n        rb_fail(bloque, \"Motor %s sin configurar: usa configurar motor al iniciar\" % motor)\n    velocidad = max(-100, min(100, velocidad))\n    if velocidad == 0:\n        motores_parar(salidas, \"libre\")\n        return\n    pwm, in1, in2 = salidas\n    in1.value(1 if velocidad > 0 else 0)\n    in2.value(0 if velocidad > 0 else 1)\n    pwm.duty_u16(int(abs(velocidad) * 65535 / 100))\n"
            ],
            "statement": "motores_velocidad({LEFT}, {LEFT_SPEED}, {BLOCK_ID})\nmotores_velocidad({RIGHT}, {RIGHT_SPEED}, {BLOCK_ID})"
          },
          "arduino": {
            "hardware": {
              "features": ["pwm"]
            },
            "globals": [
              "struct RbMotor { int pwm = -1, ina = -1, inb = -1; };\nstatic RbMotor motores_puente[4];\ninline int motores_indice(const String& motor) { return motor.length() == 1 ? motor[0] - 'A' : -1; }\ninline void motores_configurar(const String& motor, int pwm, int ina, int inb) {\n    int i = motores_indice(motor); if (i < 0 || i > 3) return;\n    motores_puente[i].pwm = pwm; motores_puente[i].ina = ina; motores_puente[i].inb = inb;\n    pinMode(pwm, OUTPUT); pinMode(ina, OUTPUT); pinMode(inb, OUTPUT);\n    digitalWrite(ina, LOW); digitalWrite(inb, LOW); analogWrite(pwm, 0);\n}\ninline void motores_parar(RbMotor& m, bool frenar) {\n    digitalWrite(m.ina, frenar ? HIGH : LOW); digitalWrite(m.inb, frenar ? HIGH : LOW);\n    analogWrite(m.pwm, frenar ? {PWM_MAX} : 0);\n}\ninline void motores_velocidad(const String& motor, float velocidad, const char* bloque) {\n    int i = motores_indice(motor);\n    if (i < 0 || i > 3 || motores_puente[i].pwm < 0) { rb_fail(bloque, \"Motor sin configurar: usa configurar motor al iniciar\"); return; }\n    velocidad = fmaxf(-100, fminf(100, rb_finite(velocidad, bloque)));\n    RbMotor& m = motores_puente[i];\n    if (velocidad == 0) { motores_parar(m, false); return; }\n    digitalWrite(m.ina, velocidad > 0 ? HIGH : LOW); digitalWrite(m.inb, velocidad > 0 ? LOW : HIGH);\n    analogWrite(m.pwm, uint32_t(fabsf(velocidad) * {PWM_MAX} / 100.0f));\n}\ninline void motores_detener(const String& motor, const String& modo) {\n    for (int i = 0; i < 4; i++) if (motores_puente[i].pwm >= 0 && (motor == \"todos\" || motores_indice(motor) == i)) motores_parar(motores_puente[i], modo == \"frenar\");\n}"
            ],
            "statement": "motores_velocidad({LEFT}, {LEFT_SPEED}, {BLOCK_ID});\nmotores_velocidad({RIGHT}, {RIGHT_SPEED}, {BLOCK_ID});"
          }
        }
      },
      {
        "id": "org.robotblocks.motores:stop",
        "category": "org.robotblocks.motores:motores",
        "label": {
          "es": "detener %MOTOR %MODE",
          "en": "stop %MOTOR %MODE"
        },
        "kind": "command",
        "fields": [
          {
            "name": "MOTOR",
            "type": "string",
            "default": "todos",
            "options": [
              {
                "label": {
                  "es": "todos los motores",
                  "en": "all motors"
                },
                "value": "todos"
              },
              {
                "label": {
                  "es": "motor A",
                  "en": "motor A"
                },
                "value": "A"
              },
              {
                "label": {
                  "es": "motor B",
                  "en": "motor B"
                },
                "value": "B"
              },
              {
                "label": {
                  "es": "motor C",
                  "en": "motor C"
                },
                "value": "C"
              },
              {
                "label": {
                  "es": "motor D",
                  "en": "motor D"
                },
                "value": "D"
              }
            ]
          },
          {
            "name": "MODE",
            "type": "string",
            "default": "frenar",
            "options": [
              {
                "label": {
                  "es": "frenando",
                  "en": "brake"
                },
                "value": "frenar"
              },
              {
                "label": {
                  "es": "en libre",
                  "en": "coast"
                },
                "value": "libre"
              }
            ]
          }
        ],
        "inputs": [],
        "operation": "org.robotblocks.motores:stop",
        "tooltip": {
          "es": "Frenando: se detiene enseguida. En libre: gira hasta pararse solo. TB6612FNG o L298N. Si el motor gira al revés, intercambia IN1 e IN2 en «configurar motor».",
          "en": "Braking: stops immediately. Coasting: spins until it stops on its own. TB6612FNG or L298N. If the motor spins backward, swap IN1 and IN2 in “configure motor”."
        },
        "requiredCapabilities": ["pwm", "digitalOutput"],
        "generators": {
          "micropython": {
            "canFail": false,
            "imports": ["from machine import Pin, PWM"],
            "globals": [
              "motores_puente = {}\n",
              "def motores_parar(salidas, modo):\n    pwm, in1, in2 = salidas\n    # Frenar: IN1 e IN2 en alto. Libre: PWM en 0 e IN1/IN2 en bajo (TB6612FNG y L298N).\n    frenar = modo == \"frenar\"\n    in1.value(1 if frenar else 0)\n    in2.value(1 if frenar else 0)\n    pwm.duty_u16(65535 if frenar else 0)\n",
              "def motores_detener(motor, modo):\n    for letra, salidas in motores_puente.items():\n        if motor == \"todos\" or motor == letra:\n            motores_parar(salidas, modo)\n"
            ],
            "statement": "motores_detener({MOTOR}, {MODE})"
          },
          "arduino": {
            "hardware": {
              "features": ["pwm"]
            },
            "globals": [
              "struct RbMotor { int pwm = -1, ina = -1, inb = -1; };\nstatic RbMotor motores_puente[4];\ninline int motores_indice(const String& motor) { return motor.length() == 1 ? motor[0] - 'A' : -1; }\ninline void motores_configurar(const String& motor, int pwm, int ina, int inb) {\n    int i = motores_indice(motor); if (i < 0 || i > 3) return;\n    motores_puente[i].pwm = pwm; motores_puente[i].ina = ina; motores_puente[i].inb = inb;\n    pinMode(pwm, OUTPUT); pinMode(ina, OUTPUT); pinMode(inb, OUTPUT);\n    digitalWrite(ina, LOW); digitalWrite(inb, LOW); analogWrite(pwm, 0);\n}\ninline void motores_parar(RbMotor& m, bool frenar) {\n    digitalWrite(m.ina, frenar ? HIGH : LOW); digitalWrite(m.inb, frenar ? HIGH : LOW);\n    analogWrite(m.pwm, frenar ? {PWM_MAX} : 0);\n}\ninline void motores_velocidad(const String& motor, float velocidad, const char* bloque) {\n    int i = motores_indice(motor);\n    if (i < 0 || i > 3 || motores_puente[i].pwm < 0) { rb_fail(bloque, \"Motor sin configurar: usa configurar motor al iniciar\"); return; }\n    velocidad = fmaxf(-100, fminf(100, rb_finite(velocidad, bloque)));\n    RbMotor& m = motores_puente[i];\n    if (velocidad == 0) { motores_parar(m, false); return; }\n    digitalWrite(m.ina, velocidad > 0 ? HIGH : LOW); digitalWrite(m.inb, velocidad > 0 ? LOW : HIGH);\n    analogWrite(m.pwm, uint32_t(fabsf(velocidad) * {PWM_MAX} / 100.0f));\n}\ninline void motores_detener(const String& motor, const String& modo) {\n    for (int i = 0; i < 4; i++) if (motores_puente[i].pwm >= 0 && (motor == \"todos\" || motores_indice(motor) == i)) motores_parar(motores_puente[i], modo == \"frenar\");\n}"
            ],
            "statement": "motores_detener({MOTOR}, {MODE});"
          }
        }
      }
    ]
  }
}
